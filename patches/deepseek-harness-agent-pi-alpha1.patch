new file mode 100644
index 0000000000000000000000000000000000000000..11cb96f1c61508e363bbd3fb99224ce814fa4ce4
--- /dev/null
+++ b/packages/compaction/compaction-basic/src/fallback.ts
@@ -0,0 +1,89 @@
+const DENIED_WORDS = new Set([
+  'abort',
+  'aborted',
+  'aborting',
+  'cancel',
+  'canceled',
+  'canceling',
+  'cancellation',
+  'cancelled',
+  'cancelling',
+  'policy',
+  'safety',
+  'shutdown',
+])
+
+const UNAVAILABLE_CODES = new Set([
+  'INVALID_CREDENTIAL',
+  'MISSING_CREDENTIAL',
+  'MODEL_NOT_FOUND',
+  'MODEL_UNAVAILABLE',
+  'NO_ADAPTER',
+  'UNKNOWN_MODEL',
+  'UNKNOWN_PROVIDER',
+])
+
+function readString(error: object, key: 'code' | 'name' | 'message'): string | undefined {
+  try {
+    const value: unknown = Reflect.get(error, key)
+    return typeof value === 'string' ? value : undefined
+  } catch {
+    return undefined
+  }
+}
+
+function normalize(value: string, splitCamelCase = false): string {
+  return (splitCamelCase ? value.replace(/([a-z0-9])([A-Z])/g, '$1 $2') : value)
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, ' ')
+    .trim()
+}
+
+function containsDeniedSignal(value: string | undefined): boolean {
+  if (value === undefined) return false
+  return normalizedContainsDeniedSignal(normalize(value))
+    || normalizedContainsDeniedSignal(normalize(value, true))
+}
+
+function normalizedContainsDeniedSignal(normalized: string): boolean {
+  const words = normalized.split(' ')
+  return words.some(word => DENIED_WORDS.has(word))
+    || normalized.includes('shut down')
+    || normalized.includes('shutting down')
+    || normalized.includes('content filter')
+}
+
+/**
+ * Determine whether a failed primary summarization may be retried through a
+ * configured cross-provider fallback.
+ */
+export function shouldTrySummarizationFallback(error: unknown, signal?: AbortSignal): boolean {
+  if (signal?.aborted === true) return false
+
+  if (typeof error === 'string') return !containsDeniedSignal(error)
+  if ((typeof error !== 'object' && typeof error !== 'function') || error === null) return true
+
+  const code = readString(error, 'code')
+  const name = readString(error, 'name')
+  const message = readString(error, 'message')
+  return !containsDeniedSignal(code)
+    && !containsDeniedSignal(name)
+    && !containsDeniedSignal(message)
+}
+
+/**
+ * Stop rather than skip past a configured fallback route that the deployment
+ * cannot serve. LLM failures expose stable codes; provider message text is not
+ * used for this decision.
+ */
+export function shouldStopSummarizationFallbackChain(error: unknown): boolean {
+  if ((typeof error !== 'object' && typeof error !== 'function') || error === null) return false
+  const code = readString(error, 'code')
+  if (code === undefined) return false
+  const normalized = code.trim()
+    .replace(/([a-z0-9])([A-Z])/g, '$1_$2')
+    .replace(/[^A-Za-z0-9]+/g, '_')
+    .replace(/^_+|_+$/g, '')
+    .toUpperCase()
+  return UNAVAILABLE_CODES.has(normalized)
+}
