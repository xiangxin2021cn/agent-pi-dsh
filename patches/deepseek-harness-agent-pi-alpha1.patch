+/** Capacity fields that carry independent values and provenance. */
+export type ModelCapacityField = 'contextWindow' | 'maxTokens'
+
+/** Persisted capacity provenance, including a value typed by the user. */
+export type ModelCapacitySource = NonNullable<LlmDiscoveredModel['contextWindowSource']> | 'user'
+
+/** Source key paired with each capacity field. */
+const CAPACITY_SOURCE_FIELD: Readonly<Record<ModelCapacityField, 'contextWindowSource' | 'maxTokensSource'>> = {
+  contextWindow: 'contextWindowSource',
+  maxTokens: 'maxTokensSource',
+}
+
+/** Whether a settings value names one accepted capacity source. */
+function isCapacitySource(value: unknown): value is ModelCapacitySource {
+  return value === 'user' || value === 'provider' || value === 'official' || value === 'estimated'
+}
+
+/**
+ * Read one configured capacity's provenance. A legacy numeric value without a
+ * source was authored by the user and remains authoritative.
+ */
+export function modelCapacitySource(
+  model: Readonly<Record<string, unknown>>,
+  field: ModelCapacityField,
+): ModelCapacitySource | undefined {
+  if (typeof model[field] !== 'number') return undefined
+  const source = model[CAPACITY_SOURCE_FIELD[field]]
+  if (source === undefined) return 'user'
+  return isCapacitySource(source) ? source : undefined
+}
+
+/**
+ * Adopt one discovered row without replacing a numeric user setting. Each
+ * capacity is independent, so non-user fields can refresh separately.
+ */
+export function adoptDiscoveredModel(
+  existing: Readonly<Record<string, unknown>> | undefined,
+  candidate: LlmDiscoveredModel,
+): Record<string, unknown> {
+  const adopted: Record<string, unknown> = existing === undefined
+    ? { id: candidate.id, ...(candidate.name === undefined ? {} : { name: candidate.name }) }
+    : { ...existing }
+  for (const field of ['contextWindow', 'maxTokens'] as const) {
+    const value = candidate[field]
+    if (value === undefined) continue
+    if (existing !== undefined && modelCapacitySource(existing, field) === 'user') continue
+    adopted[field] = value
+    const sourceField = CAPACITY_SOURCE_FIELD[field]
+    adopted[sourceField] = candidate[sourceField] ?? 'estimated'
+  }
+  return adopted
+}
