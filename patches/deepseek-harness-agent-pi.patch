+    expect(spec.summarizationFallbacks).toEqual([])
+    expect(Object.isFrozen(config.summarizationFallbacks)).toBe(true)
+    expect(Object.isFrozen(target.summarizationFallbacks)).toBe(true)
+    expect(Object.isFrozen(spec.summarizationFallbacks)).toBe(true)
+  })
+
+  it('resolves one explicit fallback and freezes the array and entry', () => {
+    const config = resolveConfig({
+      summarizationFallbacks: [{
+        provider: 'fallback-provider',
+        model: 'fallback-model',
+        maxTokens: 2048,
