+import type { RpcReceipt } from '@deepseek-ai/dsh-api-remotes/client'
+import { RpcId } from '@deepseek-ai/dsh-client-connection/client'
+import type { SnapshotSelectorHook } from '@deepseek-ai/dsh-client-ui-slots'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { ApprovalPanel, commandOf } from '../src/client/skeleton/ApprovalPanel.tsx'
+import type { ApprovalComposerProps } from '../src/client/contract/slots.ts'
+import { en, zh } from '../src/client/locales.ts'
+import { en as commonEn } from '@deepseek-ai/dsh-client-locale/src/locales/en.ts'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+
+afterEach(cleanup)
+
+const SID = 's1' as SessionId
+
+function snapshotBase(chat: ConversationSnapshot['chat'] = EMPTY_CHAT_SNAPSHOT): ConversationSnapshot {
+  return {
+    sessionId: SID, views: EMPTY_CONVERSATION_VIEWS, chat, nodes: [],
+    turnTimings: new Map(), turnEnds: new Map(), partial: null, runningCalls: [],
+    pending: [], queue: [], running: false, composerPhase: 'active', removed: false, openState: 'open', openError: null,
+    hasMore: false, loadingOlder: false, promptError: null, blank: false, subagent: null, lastAgentError: null,
+  }
+}
+
+function kit(snapshot: ConversationSnapshot = snapshotBase()) {
+  return {
+    session: undefined,
+    sessionId: SID,
+    useSession: ((sel: (s: ConversationSnapshot) => unknown) => sel(snapshot)) as unknown as SnapshotSelectorHook<ConversationSnapshot>,
+    useSessions: (() => { throw new Error('unused') }) as unknown as SnapshotSelectorHook<SessionListState>,
+    useWorkspaces: (() => { throw new Error('unused') }) as unknown as SnapshotSelectorHook<WorkspaceListState>,
+    useProjection: (() => undefined) as never,
+    useInput: (() => { throw new Error('unused') }) as never,
+    inputActions: { setDraft: () => { throw new Error('unused') }, submit: () => { throw new Error('unused') } } as never,
+    t: makeTranslate(zh, commonZh) as ApprovalComposerProps['t'],
+  }
+}
+
+function wait(
+  rpcId = 'approval-1',
+  payload: ConstructorParameters<typeof PendingWait<'approval'>>[3] = { toolName: 'bash', approvalId: 'ap1' as never, reason: 'escalate sandbox' },
+  respond = vi.fn(() => Promise.resolve<RpcReceipt>({ accepted: true })),
+) {
+  const carrier = new PendingWait('approval', RpcId(rpcId), SID, payload, respond)
+  return { carrier, respond }
+}
+
+function runningCall(over: Partial<RunningToolCall> = {}): RunningToolCall {
+  return {
+    callId: 'c1', name: 'bash', argsRaw: JSON.stringify({ command: 'ls' }),
+    turn: 1, step: 1, time: 0, callView: null, subCalls: [],
+    ...over,
+  }
+}
+
+function snapshotWithRoot(callId: string, root: ToolCallBlock): ConversationSnapshot {
+  const key = conversationContextKey('tool-call', callId)
+  const node = {
+    kind: 'tool-call', key, id: callId, target: 'chat', data: { root },
+    anchorSeq: 1, location: { kind: 'unresolved' }, visibility: 'visible',
+  } as ChatConversationViewNode
+  return snapshotBase({
+    ...EMPTY_CHAT_SNAPSHOT,
+    nodes: {
+      get: (lookup: string) => lookup === key ? node : undefined,
+      values: () => [node],
+    },
+  })
+}
+
+describe('commandOf', () => {
+  it('reads a bash-family command and hides unparseable or command-less args', () => {
+    expect(commandOf(undefined)).toBeUndefined()
+    expect(commandOf(runningCall({ argsRaw: '{' }))).toBeUndefined()
+    expect(commandOf(runningCall({ argsRaw: JSON.stringify({ path: 'x' }) }))).toBeUndefined()
+    expect(commandOf(runningCall())).toBe('ls')
+  })
+})
+
+describe('ApprovalPanel', () => {
+  it('renders the waiting strip, reason, and both actions', () => {
+    const { carrier } = wait()
+    render(<ApprovalPanel matched={carrier} interactions={[carrier]} {...kit()} />)
+    expect(screen.getByText('等待审批')).toBeTruthy()
+    expect(screen.getByText('escalate sandbox')).toBeTruthy()
+    expect(screen.getByRole('button', { name: '拒绝' })).toBeTruthy()
+    expect(screen.getByRole('button', { name: '允许一次' })).toBeTruthy()
+  })
+
+  it('falls back to the tool-name headline when the ask carries no reason', () => {
+    const { carrier } = wait('approval-2', { toolName: 'pwsh', approvalId: 'ap2' as never })
+    render(<ApprovalPanel matched={carrier} interactions={[carrier]} {...kit()} />)
+    expect(screen.getByText('工具 pwsh 请求越权执行')).toBeTruthy()
+  })
+
+  it('shows submitting while the answer is in flight and re-arms with the error on failure', async () => {
+    let reject!: (error: Error) => void
+    const respond = vi.fn(() => new Promise<RpcReceipt>((_, fail) => { reject = fail }))
+    const { carrier } = wait('approval-3', { toolName: 'bash', approvalId: 'ap3' as never, reason: 'why' }, respond)
+    render(<ApprovalPanel matched={carrier} interactions={[carrier]} {...kit()} />)
+    fireEvent.click(screen.getByRole('button', { name: '允许一次' }))
+    expect(screen.getByRole('button', { name: '提交中…' })).toHaveProperty('disabled', true)
+    expect(screen.getByRole('button', { name: '拒绝' })).toHaveProperty('disabled', true)
+    await act(async () => { reject(new Error('approval response rejected: not-pending')) })
+    expect(screen.getByRole('alert').textContent).toBe('approval response rejected: not-pending')
+    expect(screen.getByRole('button', { name: '允许一次' })).toHaveProperty('disabled', false)
+  })
+
+  it('re-arms after a rejected receipt and shows the paired command for a running call', async () => {
+    const respond = vi.fn(() => Promise.resolve<RpcReceipt>({ accepted: false, reason: 'not-pending' }))
+    const { carrier } = wait(
+      'approval-4',
+      { toolName: 'bash', approvalId: 'ap4' as never, callId: 'c1' as never, reason: 'why' },
+      respond,
+    )
+    render(<ApprovalPanel matched={carrier} interactions={[carrier]} {...kit(snapshotWithRoot('c1', runningCall()))} />)
+    expect(screen.getByText('ls')).toBeTruthy()
+    fireEvent.click(screen.getByRole('button', { name: '拒绝' }))
+    await act(async () => undefined)
+    expect(screen.getByRole('alert').textContent).toContain('not-pending')
+    expect(screen.getByRole('button', { name: '拒绝' })).toHaveProperty('disabled', false)
+  })
+
+  it('hides the command line when the paired root is missing, settled, or a different call', () => {
+    const payload = { toolName: 'bash', approvalId: 'ap5' as never, callId: 'c1' as never, reason: 'why' }
+    const { carrier: missing } = wait('a-missing', payload)
+    const { container: missingView } = render(
+      <ApprovalPanel matched={missing} interactions={[missing]} {...kit()} />)
+    expect(missingView.querySelector('[class*="command"]')).toBeNull()
+
+    const settled: ToolCallBlock = {
+      kind: 'tool-result', seq: 1, time: 0, callId: 'c1', call: { name: 'bash', argsRaw: '{"command":"ls"}' },
+      callTime: 0, content: [], isError: false, callView: null, resultView: null, subCalls: [],
+    }
+    const { carrier: done } = wait('a-done', payload)
+    const { container: doneView } = render(
+      <ApprovalPanel matched={done} interactions={[done]} {...kit(snapshotWithRoot('c1', settled))} />)
+    expect(doneView.querySelector('[class*="command"]')).toBeNull()
+
+    const { carrier: other } = wait('a-other', payload)
+    const { container: otherView } = render(
+      <ApprovalPanel matched={other} interactions={[other]} {...kit(snapshotWithRoot('c1', runningCall({ callId: 'other' })))} />)
+    expect(otherView.querySelector('[class*="command"]')).toBeNull()
+  })
+
+  it('uses the English submitting label when the seat is English', () => {
+    const respond = vi.fn(() => new Promise<RpcReceipt>(() => undefined))
+    const { carrier } = wait('approval-en', { toolName: 'bash', approvalId: 'ap-en' as never }, respond)
+    const english = { ...kit(), t: makeTranslate(en, commonEn) as ApprovalComposerProps['t'] }
+    render(<ApprovalPanel matched={carrier} interactions={[carrier]} {...english} />)
+    fireEvent.click(screen.getByRole('button', { name: 'Allow once' }))
+    expect(screen.getByRole('button', { name: 'Submitting…' })).toHaveProperty('disabled', true)
+  })
+})
