+  )
+
+  it('keeps legacy numeric capacities source-less when loading them', () => {
+    type Materialized = {
+      providers: Record<string, { models?: Record<string, unknown>[] }>
+    }
+    const parsed = configWith({ contextWindow: 65_536, maxTokens: 4096 })() as Materialized
+    const model = parsed.providers['acme-gateway']?.models?.[0]
