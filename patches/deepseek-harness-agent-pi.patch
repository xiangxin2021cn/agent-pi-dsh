@@ -0,0 +1,65 @@
+import { describe, expect, it } from 'vitest'
+import { resolveModelCapacity } from '../src/index.ts'
+
+describe('resolveModelCapacity', () => {
+  it.each([
+    'deepseek-v4-flash',
+    'deepseek-v4-pro',
+    'deepseek-v4-flash-vision-exp',
+  ])('uses official capacity for the exact trimmed ID %s', (modelId) => {
+    expect(resolveModelCapacity(`  ${modelId}  `, {})).toEqual({
+      contextWindow: 1_000_000,
+      maxTokens: 384_000,
+      contextWindowSource: 'official',
+      maxTokensSource: 'official',
+    })
+  })
+
+  it('keeps a provider context window while resolving the missing output limit', () => {
+    expect(resolveModelCapacity('deepseek-v4-flash', { contextWindow: 500_000 })).toEqual({
+      contextWindow: 500_000,
+      maxTokens: 384_000,
+      contextWindowSource: 'provider',
+      maxTokensSource: 'official',
+    })
+  })
+
+  it('keeps a provider output limit while estimating the missing context window', () => {
+    expect(resolveModelCapacity('unknown-model', { maxTokens: 16_384 })).toEqual({
+      contextWindow: 262_144,
+      maxTokens: 16_384,
+      contextWindowSource: 'estimated',
+      maxTokensSource: 'provider',
+    })
+  })
+
+  it('estimates both fields for an unknown model ID', () => {
+    expect(resolveModelCapacity('unknown-model', {})).toEqual({
+      contextWindow: 262_144,
+      maxTokens: 32_768,
+      contextWindowSource: 'estimated',
+      maxTokensSource: 'estimated',
+    })
+  })
+
+  it('does not treat a near-match model ID as official', () => {
+    expect(resolveModelCapacity('deepseek-v4-flash-preview', {})).toEqual({
+      contextWindow: 262_144,
+      maxTokens: 32_768,
+      contextWindowSource: 'estimated',
+      maxTokensSource: 'estimated',
+    })
+  })
+
+  it.each(['__proto__', 'constructor', 'toString'])(
+    'does not treat the inherited Object prototype key %s as official',
+    (modelId) => {
+      expect(resolveModelCapacity(modelId, {})).toEqual({
+        contextWindow: 262_144,
+        maxTokens: 32_768,
+        contextWindowSource: 'estimated',
+        maxTokensSource: 'estimated',
+      })
+    },
+  )
+})
