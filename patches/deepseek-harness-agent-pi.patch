index 0000000000..d6a6824ed8
--- /dev/null
+++ b/packages/llm/llm-pi-ai/src/capacity.ts
@@ -0,0 +1,53 @@
+import type { LlmCapacitySource } from '@deepseek-ai/dsh-llm'
+
+/** Provenance of a resolved model capacity value. */
+export type CapacitySource = LlmCapacitySource
+
+/** Capacity values resolved for a model together with per-field provenance. */
+export interface ResolvedModelCapacity {
+  contextWindow: number
+  maxTokens: number
+  contextWindowSource: CapacitySource
+  maxTokensSource: CapacitySource
+}
+
+interface ModelCapacity {
+  contextWindow: number
+  maxTokens: number
+}
+
+const OFFICIAL_CAPACITIES: Readonly<Record<string, ModelCapacity>> = Object.freeze({
+  'deepseek-v4-flash': { contextWindow: 1_000_000, maxTokens: 384_000 },
+  'deepseek-v4-pro': { contextWindow: 1_000_000, maxTokens: 384_000 },
+  'deepseek-v4-flash-vision-exp': { contextWindow: 1_000_000, maxTokens: 384_000 },
+})
+
+const ESTIMATED_CAPACITY: ModelCapacity = {
+  contextWindow: 262_144,
+  maxTokens: 32_768,
+}
+
+/**
+ * Resolves model capacity, preferring provider values over official or estimated fallbacks.
+ * @param modelId Model id to resolve after trimming surrounding whitespace.
+ * @param providerCapacity Capacity fields reported by the provider, when available.
+ * @returns Resolved capacity values together with per-field provenance.
+ */
+export function resolveModelCapacity(
+  modelId: string,
+  providerCapacity: { contextWindow?: number; maxTokens?: number },
+): ResolvedModelCapacity {
+  const normalizedId = modelId.trim()
+  const official = Object.hasOwn(OFFICIAL_CAPACITIES, normalizedId)
+    ? OFFICIAL_CAPACITIES[normalizedId]
+    : undefined
+  const fallback = official ?? ESTIMATED_CAPACITY
+  const fallbackSource: CapacitySource = official === undefined ? 'estimated' : 'official'
+
+  return {
+    contextWindow: providerCapacity.contextWindow ?? fallback.contextWindow,
+    maxTokens: providerCapacity.maxTokens ?? fallback.maxTokens,
+    contextWindowSource: providerCapacity.contextWindow === undefined ? fallbackSource : 'provider',
+    maxTokensSource: providerCapacity.maxTokens === undefined ? fallbackSource : 'provider',
+  }
+}
