+import { describe, expect, it } from 'vitest'
+
+import { shouldTrySummarizationFallback } from '../src/fallback.ts'
+
+describe('shouldTrySummarizationFallback', () => {
+  it.each([
+    ['uppercase abort code', { code: 'ABORTED' }],
+    ['lowercase cancellation code', { code: 'cancelled' }],
+    ['hyphenated content-filter code', { code: 'content-filter' }],
+    ['space-separated content filter code', { code: 'CONTENT FILTER' }],
+    ['shutdown code', { code: 'SHUTDOWN' }],
+    ['underscore-separated shutdown code', { code: 'SHUT_DOWN' }],
+    ['hyphen-separated shutdown code', { code: 'shut-down' }],
+    ['camel-case shutdown name', { name: 'ShutDownError' }],
+    ['policy code', { code: 'PoLiCy' }],
+    ['safety code', { code: 'SAFETY' }],
+    ['AbortError name', Object.assign(new Error('stopped'), { name: 'AbortError' })],
+    ['message-only cancellation', new Error('Operation cancelled by the user')],
+    ['message-only shutdown', new Error('Provider is shutting down')],
+    ['message-only policy rejection', new Error('Request rejected by provider policy')],
+    ['message-only safety rejection', new Error('Response was blocked by a safety system')],
+    ['message-only content filter rejection', new Error('Content-filter rejected the response')],
+    ['string policy rejection', 'Request blocked by content filtering'],
+  ])('denies %s', (_label, error) => {
+    expect(shouldTrySummarizationFallback(error)).toBe(false)
+  })
+
+  it('denies fallback when the caller signal is already aborted', () => {
+    const controller = new AbortController()
+    controller.abort()
+
+    expect(shouldTrySummarizationFallback(new Error('ordinary failure'), controller.signal)).toBe(false)
+  })
+
+  it.each([
+    ['context window exceeded', { code: 'CONTEXT_WINDOW_EXCEEDED' }],
+    ['separator-normalized maximum tokens', { code: 'max-tokens' }],
+    ['unsupported content', { code: 'unsupported content' }],
+    ['model unavailable', { code: 'model_unavailable' }],
+    ['authentication failure', { code: 'AUTHENTICATION_ERROR' }],
