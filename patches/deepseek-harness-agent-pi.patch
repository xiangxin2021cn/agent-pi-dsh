+      modelPolicies: [{
+        ...TARGET,
+        maxTokens: 4096,
+      }],
+    })
+    const target = resolveTargetPolicy(config, TARGET)
+    const spec = resolveCompactSpec(target, 100_000)
+
+    expect(config.summarizationFallbacks[0]?.maxTokens).toBe(8192)
+    expect(target.summarizationFallbacks[0]?.maxTokens).toBe(4096)
+    expect(spec.summarizationFallbacks[0]?.maxTokens).toBe(4096)
