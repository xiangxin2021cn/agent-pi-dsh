+      summarizationFallbacks: [
+        { provider: 'first-provider', model: 'first-model' },
+        { provider: 'second-provider', model: 'second-model', maxTokens: 1024 },
+      ],
+    })
+    const target = resolveTargetPolicy(config, TARGET)
+    const spec = resolveCompactSpec(target, 100_000)
+    const expected = [
+      { provider: 'first-provider', model: 'first-model', maxTokens: 4096 },
+      { provider: 'second-provider', model: 'second-model', maxTokens: 1024 },
+    ]
+
+    expect(config.summarizationFallbacks).toEqual(expected)
+    expect(target.summarizationFallbacks).toEqual(expected)
+    expect(spec.summarizationFallbacks).toEqual(expected)
+  })
+
+  it('defaults omitted maxTokens to the target policy summarization maximum', () => {
